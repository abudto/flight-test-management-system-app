# Local development only. Copy to .env and replace the placeholder key.
# Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
# Accepted booleans: true/false, yes/no, on/off, 1/0 (case-insensitive).
# Enable debugging only for local development.
DJANGO_DEBUG=false
# Comma-separated hostnames, without schemes or ports.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set false to use only process environment variables, e.g. in CI.
DJANGO_LOAD_DOTENV=true

# PostgreSQL development database. Use a dedicated owner with LOGIN, not SUPERUSER.
# These are examples: replace passwords before connecting.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=ftms_dev
DJANGO_DB_USER=ftms_app
DJANGO_DB_PASSWORD=replace-with-a-development-database-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# Separate test role with CREATEDB; never use production credentials for tests.
DJANGO_TEST_DB_NAME=test_ftms
DJANGO_TEST_DB_USER=ftms_test
DJANGO_TEST_DB_PASSWORD=replace-with-a-test-database-password
DJANGO_TEST_DB_HOST=127.0.0.1
DJANGO_TEST_DB_PORT=5432
# Set false in CI to read credentials only from process variables.
DJANGO_TEST_LOAD_DOTENV=true
